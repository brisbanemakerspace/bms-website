---
// src/components/ui/dialog/DialogTrigger.astro - Dialog compound part (see ../README.md).
// Button that opens the dialog/sheet whose `id` equals this trigger's `for`. Reuses the Button look
// (variant + size). Wired by the shared `_dialog` controller via the data-dialog-open hook.
import { button } from "@components/ui/button/Button.astro";
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"button"> & VariantProps<typeof button> & { for: string };

const { for: target, variant, size, class: className, ...rest } = Astro.props;
---

<button
  type="button"
  data-dialog-open={target}
  data-slot="dialog-trigger"
  class={button({ variant, size, class: className })}
  {...rest}
>
  <slot />
</button>
