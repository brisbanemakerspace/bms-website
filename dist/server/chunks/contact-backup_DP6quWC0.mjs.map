---
// src/components/ui/dialog/DialogFooter.astro - Dialog compound part (see ../README.md).
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"div"> & VariantProps<typeof dialogFooter>;

export const dialogFooter = tv({
  base: ["flex flex-col-reverse gap-2 sm:flex-row sm:justify-end"],
});

const { class: className, ...rest } = Astro.props;
---

<div class={dialogFooter({ class: className })} data-slot="dialog-footer" {...rest}><slot /></div>
