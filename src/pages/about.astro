---
// About (/about/). Thin route shell: owns BaseLayout + SEO and composes Sections/About/AboutUs in the
// same shell as the other pages (one .site-container + gap rhythm). Content is carried over from the
// old brisbanemaker.space/about-us/. The earlier portfolio-style About sections (Hero, DevProfile,
// SkillTree, Achievements, Gear) are no longer used by this page.
import AboutUs from "@components/Sections/About/AboutUs.astro";
import siteData from "@config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title={`About - ${siteData.tabTitle}`}
  description="Brisbane Makerspace is an incorporated association and registered charity in Brisbane/Meanjin, run entirely by volunteers and built around our shared love of making."
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <AboutUs />
  </div>
</BaseLayout>
