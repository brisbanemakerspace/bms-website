---
// Home (/). Thin route shell: owns BaseLayout + SEO and composes Sections/Home. One shared
// `.site-container` wraps every section for a single column width aligned with the header/footer;
// `gap-*` gives the vertical rhythm. Content is carried over from the old brisbanemaker.space homepage.
// (The earlier portfolio-style home sections — Hero, Stats, LatestPosts, TechStack, FeaturedProjects,
// About — are no longer used by this page.)
import CommunityProjects from "@components/Sections/Home/CommunityProjects.astro";
import Contact from "@components/Sections/Home/Contact.astro";
import Offer from "@components/Sections/Home/Offer.astro";
import Video from "@components/Sections/Home/Video.astro";
import Welcome from "@components/Sections/Home/Welcome.astro";
import WhatIsAMakerspace from "@components/Sections/Home/WhatIsAMakerspace.astro";
import Workshops from "@components/Sections/Home/Workshops.astro";
import siteData from "@config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title={siteData.title}
  tabTitle={siteData.tabTitle}
  description={siteData.description}
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <Welcome />
    <Offer />
    <Video />
    <Workshops />
    <CommunityProjects />
    <WhatIsAMakerspace />
    <Contact />
  </div>
</BaseLayout>
