---
// src/components/Sections/Home/Welcome.astro — the home hero for Brisbane Makerspace: the shared
// Global/HeroPanel plus two CTAs (Visit Us / Membership) through its slot. Above the fold, so no
// scroll-reveal. Copy is carried over from the old brisbanemaker.space homepage. A members photo sits
// beside the hero on md+ (below it on phones).
import HeroPanel from "@components/Sections/Global/HeroPanel.astro";
import siteData from "@config/siteData.json";
import members from "@images/members.jpeg";
import { Picture } from "astro:assets";

const { routes } = siteData.links;
---

<div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,28rem)]">
<HeroPanel
  headingId="hero-heading"
  tagline="Meanjin / Brisbane"
  heading="Be part of a community"
  headingIcon="raising-hands"
  intro="Brisbane's largest community workshop for makers, artists & tinkerers."
>
  <div class="flex flex-col gap-4 pt-2 sm:flex-row">
    <a href={routes.visit} class="pixel-btn pixel-btn--blue px-5 py-4 text-sm uppercase sm:text-base">
      Visit Us
    </a>
    <a href={routes.membership} class="pixel-btn px-5 py-4 text-sm uppercase sm:text-base">
      Membership
    </a>
  </div>
</HeroPanel>

  <Picture
    src={members}
    widths={[320, 400, 600]}
    sizes="(min-width: 768px) 28rem, 100vw"
    formats={["avif", "webp"]}
    alt="Four members playing a board game around a table, with a Progress Pride flag on the wall behind them."
    loading="eager"
    fetchpriority="high"
    class="border-border shadow-pixel-lg h-auto w-full border-4 object-cover md:h-full"
  />
</div>
