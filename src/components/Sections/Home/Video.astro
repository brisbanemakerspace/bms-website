---
// src/components/Sections/Home/Video.astro - the homepage walkthrough video (a standard YouTube embed),
// carried over from the old brisbanemaker.space homepage. Change `videoId` to swap the video.
import SectionHeading from "@components/Sections/Global/SectionHeading.astro";
import { PixelPanel } from "@components/ui/pixel-panel";
import { Reveal } from "@components/ui/reveal";

const videoId = "ag2dKPIn9Kg";
---

<Reveal as="section" aria-labelledby="video-heading" class="flex flex-col gap-6">
  <SectionHeading id="video-heading" title="Take a look inside" />
  <PixelPanel class="p-3 md:p-4">
    <iframe
      src={`https://www.youtube.com/embed/${videoId}`}
      title="Brisbane Makerspace walkthrough video"
      class="aspect-video w-full"
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen></iframe>
  </PixelPanel>
</Reveal>
