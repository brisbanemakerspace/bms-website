---
// Shared renderer for the legal documents (currently just the Privacy Policy). Layout-free section: the route
// owns BaseLayout + SEO, reads the legalData record, and passes it in as `page` - so one
// component serves both documents. Content is config-driven: edit
// src/config/legalData.json.ts, not this component.
//
// ponytail: sections render as a heading + paragraphs only (no nested lists/tables). For richer
// legal docs, promote legalData to a markdown content collection and render <Content /> here.
import { type LegalBlock, type LegalPageProps } from "@config/types/configDataTypes";
import { formatDate } from "@js/textUtils";

interface Props {
  page: LegalPageProps;
}

const { page } = Astro.props as Props;

const has = <K extends string>(b: LegalBlock, key: K): b is Extract<LegalBlock, Record<K, unknown>> =>
  typeof b !== "string" && key in b;
---

<article class="site-container mx-auto max-w-3xl py-16 md:py-24">
  <header class="border-border flex flex-col gap-3 border-b pb-8">
    <h1 class="h1 text-balance"><span class="main-text-gradient">{page.title}</span></h1>
    <p class="text-muted-foreground text-sm">
      Last updated:{" "}
      <time datetime={page.lastUpdated}>{formatDate(page.lastUpdated)}</time>
    </p>
  </header>

  <p class="description mt-8 text-balance">{page.intro}</p>

  {
    page.introBlocks && page.introBlocks.length > 0 && (
      <div class="mt-6 flex flex-col gap-3">
        {page.introBlocks.map((block) =>
          typeof block === "string" ? (
            <p class="text-foreground/90 leading-relaxed">{block}</p>
          ) : has(block, "list") ? (
            <ul class="text-foreground/90 list-disc space-y-1 pl-6 leading-relaxed">
              {block.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null,
        )}
      </div>
    )
  }

  <div class="mt-8 flex flex-col gap-8">
    {
      page.sections.map((section) => (
        <section class="flex flex-col gap-3">
          <h2 class="h3 text-foreground">{section.heading}</h2>
          {section.body.map((block) =>
            typeof block === "string" ? (
              <p class="text-foreground/90 leading-relaxed">{block}</p>
            ) : has(block, "subheading") ? (
              <h3 class="text-foreground mt-2 font-bold">{block.subheading}</h3>
            ) : (
              <ul class="text-foreground/90 list-disc space-y-1 pl-6 leading-relaxed">
                {block.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ),
          )}
        </section>
      ))
    }
  </div>
</article>
