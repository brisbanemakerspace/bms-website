---
// src/components/Sections/Visit/Visit.astro - the Visit Us page body: location, when to visit and how
// to get there. Copy and links are carried over from the old brisbanemaker.space/visit-us/. One-off
// section copy lives here as typed literals (see AGENTS.md "content tiers"); edit this file to change
// the wording, address or links.
//
// The map is plain links to Google Maps and Apple Maps (not an embedded iframe) so visiting this page doesn't send
// visitors' data to Google until they choose to click.
import HeroPanel from "@components/Sections/Global/HeroPanel.astro";
import MapEmbed from "@components/Sections/Global/MapEmbed.astro";
import { PixelPanel } from "@components/ui/pixel-panel";
import siteData from "@config/siteData.json";
import { socialHref } from "@config/socialData.json";

const discord = socialHref("discord");
const eventsUrl = siteData.links.routes.events;
const gettingThereUrl = siteData.links.wikiPages.gettingThere;
const address = siteData.address;

const travel = [
  {
    title: "By Car",
    body: "There is street parking nearby, but much of it becomes tow-away from 4-6pm.",
    more: true,
  },
  {
    title: "Bus or Train",
    body: "We're a 10-15 minute walk from multiple train stations, with many more bus stops nearby.",
  },
  {
    title: "Ride or Scoot",
    body: "We're accessible to most of inner Brisbane by bike or scooter.",
  },
] as const;

const link = "text-info hover:text-success underline transition-colors";
const ext = { target: "_blank", rel: "noopener noreferrer" } as const;
---

<HeroPanel
  headingId="visit-hero-heading"
  tagline="Visit Us"
  heading="Visit Us"
  intro="Visit Brisbane's friendliest makerspace and community workshop."
/>

<section aria-labelledby="visit-intro-heading">
  <PixelPanel class="flex flex-col gap-4 p-6 md:p-8">
    <h2 id="visit-intro-heading" class="h3 text-foreground">Before you come</h2>
    <p class="text-foreground/90 leading-relaxed">
      We're a volunteer powered not-for-profit, run for the benefit of our community. We are primarily a
      social group where people can make new connections, and socialise around our common love of
      making. Whilst we have great facilities, if you're looking for a space with commercial
      levels of support or service, we may not be a match.
    </p>
    <p class="text-foreground/90 leading-relaxed">
      Our volunteers and members are regularly on-site throughout the week, but we don't employ staff
      during normal business hours.
    </p>
  </PixelPanel>
</section>

<div class="grid gap-8 md:grid-cols-2">
  <section aria-labelledby="location-heading">
    <PixelPanel class="flex h-full flex-col items-start gap-4 p-6 md:p-8">
      <h2 id="location-heading" class="h3 text-foreground">Our Address</h2>
      <address class="text-foreground/90 not-italic leading-relaxed">{address}</address>
      <p class="text-muted-foreground text-sm">Membership required outside of public events.</p>
    </PixelPanel>
  </section>

  <section aria-labelledby="when-heading">
    <PixelPanel class="flex h-full flex-col items-start gap-4 p-6 md:p-8">
      <h2 id="when-heading" class="h3 text-foreground">When To Visit</h2>
      <p class="text-foreground/90 leading-relaxed">
        We're open to the public every Monday 6-8pm and during public events. See
        events <a href={eventsUrl} class={link}>here</a>.
      </p>
      <h3 class="font-display text-info text-sm uppercase">Can't Make Mondays?</h3>
      <p class="text-foreground/90 leading-relaxed">
        Join our Discord and ask a volunteer.
      </p>
      <a href={discord} class="pixel-btn pixel-btn--blue px-5 py-3 text-xs uppercase" {...ext}>Join Discord</a>
    </PixelPanel>
  </section>
</div>

<section aria-labelledby="getting-there-heading">
  <PixelPanel class="flex flex-col gap-6 p-6 md:p-8">
    <h2 id="getting-there-heading" class="h3 text-foreground">How To Get There</h2>
    <ul class="grid gap-6 md:grid-cols-3">
      {
        travel.map((item) => (
          <li class="flex flex-col gap-2">
            <h3 class="font-display text-info text-sm uppercase">{item.title}</h3>
            <p class="text-foreground/90 leading-relaxed">
              {item.body}
              {"more" in item && (
                <>
                  {" "}See <a href={gettingThereUrl} class={link} {...ext}>getting there</a> for more information.
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </PixelPanel>
</section>

<MapEmbed />
