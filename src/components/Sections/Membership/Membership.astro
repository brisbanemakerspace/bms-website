---
// src/components/Sections/Membership/Membership.astro - the Membership page body: maker plans for
// hobbyists and coworking plans for professionals. Copy, prices and links are carried over from the
// old brisbanemaker.space/membership/. One-off section copy lives here as typed literals (see AGENTS.md
// "content tiers"); edit the `makerPlans` / `coworkingPlans` arrays to change a plan or a price.
//
// Both groups are shown one after the other (the old page switched between them with tabs), so the page
// needs no JavaScript. Hobbyist plans sign up through the member portal; coworking plans go through
// the contact page.
import HeroPanel from "@components/Sections/Global/HeroPanel.astro";
import FeatureText, { type Feature } from "@components/Sections/Membership/FeatureText.astro";
import { PixelPanel } from "@components/ui/pixel-panel";
import siteData from "@config/siteData.json";

const { portalSignup, routes, wikiPages } = siteData.links;
const eventsUrl = routes.events;
const contactUrl = routes.contact;
const feesUrl = wikiPages.fees;
const fairUseUrl = wikiPages.fairUse;
const toolsUrl = wikiPages.lasercutterTools;

interface Plan {
  name: string;
  price: number;
  href: string;
  features: readonly Feature[];
}

const fees: Feature = {
  text: "Additional usage-based charges may occur for some tools - ",
  label: "check here",
  href: feesUrl,
};
const tools = "Access to 3D printers, laser cutter, electronics, woodworking and more*";
const minTerm = "3 month minimum term (cancel anytime after)";
const warmFuzzy = "A warm fuzzy feeling for supporting our community space";
const access = "24/7 access to the space and tools#";

// Signup steps, in order. The numbers are CSS counters on the <ol>, so they stay in sync with the list.
const signupSteps: readonly { text: string; link?: { label: string; href: string } }[] = [
  { text: "See what the space is like.", link: { label: "Visit Us", href: routes.visit } },
  { text: "Sign up online using the links below." },
  { text: "Complete the online video induction." },
  { text: "Collect your swipe card during an open night." },
  { text: "Organise your tool inductions." },
];

const makerPlans: readonly Plan[] = [
  {
    name: "Concession",
    price: 42,
    href: portalSignup,
    features: [
      tools,
      access,
      fees,
      warmFuzzy,
      minTerm,      
      "Commercial use^",
      "Must present concession or healthcare card during signup",
    ],
  },
  {
    name: "Maker Lite",
    price: 49,
    href: portalSignup,
    features: [
      tools,
      access,
      fees,
      warmFuzzy,
      minTerm,
    ],
  },
  {
    name: "Maker Plus",
    price: 69,
    href: portalSignup,
    features: [
      tools,
      access,
      fees,
      warmFuzzy,
      minTerm,
      "Commercial use^",
    ],
  },
];

const deskTerm = "3 month minimum term with pay by invoice available (cancel anytime after that)";
const deskCommon: readonly Feature[] = [
  tools,
  fees,
  {
    text: "Commercial use as per our",
    label: "Fair Use Policy",
    href: fairUseUrl,
  },
  deskTerm,
  "High speed WiFi and unlimited 24/7 access#",
];

const coworkingPlans: readonly Plan[] = [
  {
    name: "Hot Desk",
    price: 159,
    href: contactUrl,
    features: ["A hot desk anytime you need", ...deskCommon],
  },
  {
    name: "Dedicated Desk",
    price: 269,
    href: contactUrl,
    features: ["Your own dedicated desk", ...deskCommon],
  },
];

// Comparison-table rows: every distinct feature across a group's plans. A feature is "the same row" when
// its text (and link label) match, so shared lines line up and a plan-specific one (e.g. "Must present
// concession or healthcare card") only ticks its own column. A feature a plan has that no earlier plan
// had is slotted in just before that plan's next already-listed feature, so it sits beside its
// counterpart (the Dedicated Desk line lands directly under the Hot Desk line) instead of at the bottom.
const featureKey = (f: Feature) => (typeof f === "string" ? f : `${f.text} ${f.label}`);
const rowsFor = (plans: readonly Plan[]) => {
  const rows: { key: string; feature: Feature }[] = [];
  for (const plan of plans) {
    plan.features.forEach((feature, i) => {
      const key = featureKey(feature);
      if (rows.some((r) => r.key === key)) return;
      const next = plan.features.slice(i + 1).map(featureKey);
      const at = rows.findIndex((r) => next.includes(r.key));
      rows.splice(at === -1 ? rows.length : at, 0, { key, feature });
    });
  }
  return rows;
};

const link = "text-info hover:text-highlight underline transition-colors";
const ext = { target: "_blank", rel: "noopener noreferrer" } as const;
---

<HeroPanel
  headingId="membership-hero-heading"
  tagline="Join Us"
  heading="Membership"
  intro="How do I sign up and what does it cost?"
/>

<section aria-labelledby="signup-steps-heading">
  <PixelPanel class="flex flex-col gap-6 p-6 md:p-8">
    <h2 id="signup-steps-heading" class="h2 text-foreground text-base leading-7 md:text-xl md:leading-8">
      How to become a member
    </h2>
    <ol class="grid w-full gap-4 md:grid-cols-5">
      {
        signupSteps.map((step, i) => (
          <li class="border-border bg-muted flex items-start gap-3 border-4 p-4 md:flex-col">
            <span class="bg-primary text-primary-foreground font-display flex size-8 shrink-0 items-center justify-center text-xs">
              {i + 1}
            </span>
            <div class="flex flex-col items-start gap-3">
              <span class="text-foreground/90 text-sm leading-relaxed">{step.text}</span>
              {step.link && (
                <a href={step.link.href} class="pixel-btn pixel-btn--blue px-3 py-2 text-[10px] uppercase">
                  {step.link.label}
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="text-muted-foreground text-sm">The entire process typically takes 1-2 weeks including the time needed for your tool inductions. Please note that we do not offer short term or daily membership options.</p>
  </PixelPanel>
</section>


{
  [
    {
      id: "maker-plans",
      title: "Maker plans for hobbyists & independent makers",
      intro:
        "Join our community and connect with other makers. For individuals who want access to our space for personal use and social reasons. You can also select a discounted yearly plan when signing up.",
      plans: makerPlans,
      footnote: (
        <>
          <sup>*</sup> Our <a href={toolsUrl} class={link} {...ext}>fair use policy</a> applies and some tools require safety
          induction before use. <sup>^</sup> Personal commercial use allows low volumes of sales on Etsy, at local
          markets, etc. and does not allow high volume use or manufacturing. <sup>#</sup> Noise restrictions restrict access to loud tools between certain hours.
        </>
      ),
    },
    {
      id: "coworking-plans",
      title: "Coworking plans for full-time professionals",
      intro:
        "Whilst we provide membership options that permit commercial use, we do so to help us fund our primary charitable objectives. Our facilities are volunteer run and may not have the same level of service you'd expect with a typical commercial lease and are priced with this in mind.",
      plans: coworkingPlans,
      footnote: (
        <>
          <sup>*</sup> Our <a href={toolsUrl} class={link} {...ext}>fair use policy</a> applies and some tools require safety
          induction before use. <sup>^</sup> Personal commercial use allows low volumes of sales on Etsy, at local
          markets, etc. and does not allow high volume use or manufacturing. <sup>#</sup> Noise restrictions restrict access to loud tools between certain hours. Limited additional storage options available from $100/mth with dedicated
          desk memberships.
        </>
      ),
    },
  ].map((group) => (
    <section id={group.id} aria-labelledby={`${group.id}-heading`} class="scroll-mt-24">
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-3">
          <h2 id={`${group.id}-heading`} class="h2 text-foreground text-base leading-7 md:text-xl md:leading-8">
            {group.title}
          </h2>
          <p class="text-foreground/90 leading-relaxed">{group.intro}</p>
        </div>

        {/* md+: one comparison table - plans as columns, features as rows. */}
        <PixelPanel class="hidden overflow-x-auto p-6 md:block md:p-8">
          <table class="w-full border-collapse text-left">
            <caption class="sr-only">{group.title}: what each plan includes</caption>
            <thead>
              <tr>
                <td class="w-2/5"></td>
                {group.plans.map((plan) => (
                  <th scope="col" class="px-3 pb-4 align-bottom font-normal">
                    <span class="font-display text-info block text-xs uppercase">{plan.name}</span>
                    <span class="text-foreground mt-2 flex items-baseline gap-2">
                      <span class="font-display text-3xl">${plan.price}</span>
                      <span class="text-muted-foreground text-sm">/ month</span>
                    </span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rowsFor(group.plans).map((row) => (
                <tr class="border-border/40 border-t">
                  <th scope="row" class="text-foreground/90 py-4 pr-4 text-sm leading-relaxed font-normal">
                    <FeatureText feature={row.feature} />
                  </th>
                  {group.plans.map((plan) => (
                    <td class="px-3 py-4">
                      {plan.features.some((f) => featureKey(f) === row.key) ? (
                        <>
                          <span class="bg-primary block size-3" aria-hidden="true" />
                          <span class="sr-only">Included</span>
                        </>
                      ) : (
                        <>
                          <span class="text-muted-foreground font-display block text-sm leading-none" aria-hidden="true">
                            X
                          </span>
                          <span class="sr-only">Not included</span>
                        </>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="border-border/40 border-t">
                <td class="pt-6"></td>
                {group.plans.map((plan) => (
                  <td class="px-3 pt-6">
                    <a
                      href={plan.href}
                      class="pixel-btn pixel-btn--green flex px-5 py-3 text-xs uppercase"
                      {...(plan.href.startsWith("http") ? ext : {})}
                    >
                      Sign Up<span class="sr-only">&nbsp;for {plan.name}</span>
                    </a>
                  </td>
                ))}
              </tr>
            </tfoot>
          </table>
        </PixelPanel>

        {/* Below md: a swipeable carousel, one plan per slide (CSS scroll-snap; the dots are an extra). */}
        <div class="md:hidden" data-carousel>
          <ul
            class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pr-6 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            aria-label={`${group.title}: swipe to compare plans`}
          >
            {group.plans.map((plan) => (
              <li class="flex shrink-0 basis-[85%] snap-center" data-slide>
                <PixelPanel class="flex w-full flex-col gap-4 p-6">
                  <h3 class="font-display text-info text-sm uppercase">{plan.name}</h3>
                  <p class="text-foreground flex items-baseline gap-2">
                    <span class="font-display text-3xl">${plan.price}</span>
                    <span class="text-muted-foreground text-sm">/ month</span>
                  </p>
                  <ul class="text-foreground/90 flex flex-col text-sm leading-relaxed">
                    {plan.features.map((feature) => (
                      <li class="border-border/40 flex items-start gap-3 border-t py-3">
                        <span class="bg-primary mt-1.5 block size-3 shrink-0" aria-hidden="true" />
                        <span>
                          <FeatureText {feature} />
                        </span>
                      </li>
                    ))}
                  </ul>
                  <a
                    href={plan.href}
                    class="pixel-btn pixel-btn--green mt-auto flex px-5 py-3 text-xs uppercase"
                    {...(plan.href.startsWith("http") ? ext : {})}
                  >
                    Sign Up<span class="sr-only">&nbsp;for {plan.name}</span>
                  </a>
                </PixelPanel>
              </li>
            ))}
          </ul>
          <div class="flex items-center justify-center gap-3" role="group" aria-label="Choose a plan">
            {group.plans.map((plan, i) => (
              <button
                type="button"
                data-dot
                aria-label={`Show ${plan.name}`}
                aria-current={i === 0 ? "true" : undefined}
                class="bg-border/50 aria-[current=true]:bg-primary size-3 cursor-pointer"
              />
            ))}
          </div>
        </div>

        <p class="text-muted-foreground text-xs leading-relaxed">{group.footnote}</p>
      </div>
    </section>
  ))
}

<section aria-labelledby="membership-intro-heading">
  <PixelPanel class="flex flex-col gap-4 p-6 md:p-8">
    <h2 id="membership-intro-heading" class="h2 text-foreground text-base leading-7 md:text-xl md:leading-8">Do I need a membership?</h2>
    <p class="text-foreground/90 leading-relaxed">
      You don't need a membership to attend our public <a href={eventsUrl} class={link}
        >meetups and events</a
      > or chat online. If you're a non-profit group looking for a meetup space, <a
        href={contactUrl}
        class={link}>get in touch</a
      >. Unfortunately, to use any of our tools, you must become a member due to training and insurance requirements.
    </p>

    <p class="text-foreground/90 leading-relaxed">
      It's also good to know that we're 100% volunteer run so things can take a bit longer than expected. We do our best to keep the space clean and tidy, but we rely on members to help out with cleaning and maintenance. If you're after a professional workshop space, membership may not be right for you.
    </p>
  </PixelPanel>
</section>

<script>
  // Carousel dots: mark the slide that is mostly in view, and jump to a slide when its dot is pressed.
  // Without JS the carousel still swipes (CSS scroll-snap); only the dot highlighting is lost.
  const init = () => {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
      const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
      const dots = [...root.querySelectorAll<HTMLElement>("[data-dot]")];
      const track = slides[0]?.parentElement;
      if (!track || slides.length !== dots.length) return;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const i = slides.indexOf(entry.target as HTMLElement);
            dots.forEach((dot, n) => dot.setAttribute("aria-current", String(n === i)));
          }
        },
        { root: track, threshold: 0.6 },
      );
      slides.forEach((slide) => observer.observe(slide));
      dots.forEach((dot, i) =>
        dot.addEventListener("click", () =>
          slides[i]?.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" }),
        ),
      );
    });
  };
  document.addEventListener("astro:page-load", init);
</script>
