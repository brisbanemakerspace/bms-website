---
// src/components/Sections/Membership/FeatureText.astro - one plan feature: plain text, or text followed
// by a wiki/policy link (opens in a new tab). Shared by the comparison table and the mobile carousel.
export type Feature = string | { text: string; label: string; href: string };

interface Props {
  feature: Feature;
}
const { feature } = Astro.props;
// A trailing "*", "^" or "#" is a footnote marker: rendered as a superscript.
const marked = (text: string) => {
  const m = /^(.*?)([*^#])$/.exec(text);
  return m ? ([m[1], m[2]] as const) : ([text, ""] as const);
};
const link = "text-info hover:text-highlight underline transition-colors";
---

{
  typeof feature === "string" ? (
    <>
      {marked(feature)[0]}
      {marked(feature)[1] && <sup>{marked(feature)[1]}</sup>}
    </>
  ) : (
    <>
      {feature.text}{" "}
      <a href={feature.href} class={link} target="_blank" rel="noopener noreferrer">
        {feature.label}
      </a>
    </>
  )
}
